{
  "name": "parqueadero-grpc",
  "version": "1.0.0",
  "description": "Plataforma de gestión de parqueadero con gRPC (ConnectRPC + Protobuf) y microservicios",
  "scripts": {
    "generate": "buf lint && buf generate",
    "build:web": "esbuild web/src/main.ts --bundle --minify --sourcemap --target=es2022 --outfile=web/public/app.js",
    "build": "npm run build:web",
    "start:billing": "tsx src/billing/server.ts",
    "start:parking": "tsx src/parking/server.ts",
    "dev": "npm run build:web && concurrently --kill-others -n billing,parking -c magenta,cyan \"BILLING_GRPC_PORT=50051 npm run start:billing\" \"GRPC_PORT=50052 npm run start:parking\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "concurrently --kill-others -n billing,parking -c magenta,cyan \"npm run start:billing\" \"npm run start:parking\"",
    "grpc:demo": "tsx scripts/grpc-native-client.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "concurrently": "^10.0.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
